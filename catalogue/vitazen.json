ify.com/s/files/1/0702/3208/0427/files/9F887D89-52E0-402D-ABEF-3BBF3D50D2B4.jpg?v=1791216397","https://cdn.shopify.com/s/files/1/0702/3208/0427/files/DCDC60E1-0C61-4EC9-B954-3FD982DCCF24.jpg?v=1791216263","https://cdn.shopify.com/s/files/1/0702/3208/0427/files/Image11_215452fc-e4b7-49b1-af39-07be1f5471ff.png?v=1791214459","https://cdn.shopify.com/s/files/1/0702/3208/0427/files/Image15_2f3a9233-a0fd-455e-b5f7-4c9c9fde4677.png?v=1791214459","https://cdn.shopify.com/s/files/1/0702/3208/0427/files/Image5_0dde1fba-955c-4f86-afb0-d2a110283e20.png?v=1791214459","https://cdn.shopify.com/s/files/1/0702/3208/0427/files/Image_18_0255670d-792d-44e9-a0e3-e33f032318b3.png?v=1791214459"],"video":"","oldPrice":24000,"active":true,"stockLeft":0,"variantLabel":"Couleur","variants":["rose","bleu","violet"],"packs":[{"qty":1,"label":"1 unité","price":12000,"tag":""}],"benefits":["Rasage doux","2 têtes de précision","Rechargeable & résistant à l’eau","les aisselles","les jambes","la ligne externe du maillot","la barbe","le visage","les petits contours","l’entretien des cheveux courts","Type : rasoir / tondeuse électrique rechargeable","Modèle : HR-01"],"description":"<p style=\"text-align:center\"><span style=\"font-size:19px\">Fini les rasoirs qui agressent votre peau : profitez d’un rasage doux, propre et précis, même sur les zones sensibles.</span><br></p><p style=\"text-align:center\">Prenez soin de votre corps sans multiplier les rasoirs et accessoires. Le Rasoir Électrique Intime 3 en 1 permet de tailler, raser et réaliser vos finitions facilement à domicile.</p><p style=\"text-align:center\">Sa conception à 2 têtes permet d’abord de raccourcir les poils avec la tête tondeuse, puis d’utiliser la tête circulaire pour une finition plus proche de la peau. Il convient aux femmes comme aux hommes.</p><p style=\"text-align:center\">Vous pouvez notamment l’utiliser pour :</p><p style=\"text-align:center\">Compact et rechargeable, il est pratique à utiliser à la maison comme en déplacement.</p><p style=\"text-align:center\">Compositions</p><p style=\"text-align:center\">Comment l'utiliser</p><p style=\"text-align:center\">Ce que vous recevez</p><p style=\"text-align:center\">Questions fréquentes</p><p style=\"text-align:center\">Le rasoir convient-il aux femmes et aux hommes ?</p><p style=\"text-align:center\">Oui. Il peut être utilisé aussi bien pour l’entretien du corps chez la femme que pour la barbe, les contours et les cheveux très courts chez l’homme.</p><p style=\"text-align:center\">Est-il rechargeable et résistant à l’eau ?</p><p style=\"text-align:center\">Oui, recharge par câble Type-C, protection IPX7, utilisation à sec ou en milieu humide. Ne rechargez jamais l’appareil lorsqu’il est mouillé et séchez le port de charge avant de le brancher.</p><p style=\"text-align:center\">Paiement et livraison ?</p><p style=\"text-align:center\">Paiement à la livraison. Livraison Bamako.</p>","faq":[],"reviews":[],"landing":true,"whatsapp":false,"template":"","sections":{"benefits":false},"stockRef":"RASOIR"}],"templates":[],"themes":[{"id":"sjjs0pnnz","name":"H24 Prestige & Impact Ultra — Corrigé Ti","settings":{"primary":"#111827","accent":"#F59E0B","bgMode":"light","bgColor":"#F8FAFC","btnRadius":12,"btnPulse":false,"fieldBg":"#FFFFFF","fieldBorder":"#CBD5E1","labelColor":"#111827","sectionOrder":["header","video","gallery","benefits","form","trust","note","reviews","faq","description"],"sectionHidden":{}},"updated":"2026-10-26T05:49:08.740Z"},{"id":"f0qtzopzh","name":"H24 Prestige & Impact Ultra — Corrigé Ti","settings":{"primary":"#111827","accent":"#F59E0B","bgMode":"light","bgColor":"#F8FAFC","btnRadius":12,"btnPulse":false,"fieldBg":"#FFFFFF","fieldBorder":"#CBD5E1","labelColor":"#111827","sectionOrder":["header","video","gallery","benefits","form","trust","note","reviews","faq","description"],"sectionHidden":{}},"updated":"2026-10-26T05:44:20.533Z"},{"id":"zfa903ary","name":"Thème principal","settings":{"primary":"#ffffff","accent":"#76bb40",